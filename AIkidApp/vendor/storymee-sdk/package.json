{
  "name": "@storymee/sdk",
  "version": "0.2.0",
  "description": "StoryMee client capability SDK — auth, billing, generate, family (gateway-only)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "default": "./dist/auth/index.js"
    },
    "./generate": {
      "types": "./dist/generate/index.d.ts",
      "default": "./dist/generate/index.js"
    },
    "./billing": {
      "types": "./dist/billing/index.d.ts",
      "default": "./dist/billing/index.js"
    },
    "./family": {
      "types": "./dist/family/index.d.ts",
      "default": "./dist/family/index.js"
    },
    "./profile": {
      "types": "./dist/profile/index.d.ts",
      "default": "./dist/profile/index.js"
    },
    "./media": {
      "types": "./dist/media/index.d.ts",
      "default": "./dist/media/index.js"
    },
    "./lms": {
      "types": "./dist/lms/index.d.ts",
      "default": "./dist/lms/index.js"
    },
    "./notifications": {
      "types": "./dist/notifications/index.d.ts",
      "default": "./dist/notifications/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json -w",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "axios": "^1.7.2",
    "typescript": "^5.7.3"
  },
  "license": "UNLICENSED",
  "private": true
}
